[Unit]
Description=Chain Indexer — Multi-chain blockchain data ingestion
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/chain-indexer
Environment=NODE_ENV=production
Environment=DATA_DIR=/var/lib/chain-indexer/jsonl
Environment=STATE_DIR=/var/lib/chain-indexer/state
Environment=CLICKHOUSE_DATABASE=wallet_memory
EnvironmentFile=/opt/chain-indexer/.env

ExecStart=/usr/bin/node --import tsx /opt/chain-indexer/src/index.ts
Restart=always
RestartSec=10
LimitNOFILE=65536
MemoryMax=4G

StandardOutput=journal
StandardError=journal
SyslogIdentifier=chain-indexer

[Install]
WantedBy=multi-user.target
