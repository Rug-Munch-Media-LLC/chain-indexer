# ── Cloudflare R2 credentials ──────────────────────────────────────────────
# Required for uploading Parquet files to R2.
# Get these from the Cloudflare dashboard → R2 → Manage API Tokens.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://{account_id}.r2.cloudflarestorage.com
R2_BUCKET=rmi-data
R2_ACCOUNT_ID=8f9bd9165c1250b426c66dc1967deefd

# ── Data directories ───────────────────────────────────────────────────────
# Defaults are set in chains.ts — only override if you need non-standard paths.
# DATA_DIR=/srv/data/chain-indexer/jsonl
# STATE_DIR=/srv/data/chain-indexer/state
