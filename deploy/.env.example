# ── Backblaze B2 credentials ──────────────────────────────────────────────
# Migrated from R2 to B2 2026-07-31
# Required for uploading Parquet files to B2.
# Get these from the Backblaze dashboard → App Keys.
B2_ACCOUNT_ID=
B2_APPLICATION_KEY=
B2_BUCKET=rmi-data

# ── Data directories ───────────────────────────────────────────────────────
# Defaults are set in chains.ts — only override if you need non-standard paths.
# DATA_DIR=/srv/data/chain-indexer/jsonl
# STATE_DIR=/srv/data/chain-indexer/state
